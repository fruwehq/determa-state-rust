{
  "type": "object",
  "required": [
    "archive_format",
    "archive_schema_version",
    "source",
    "participant_contract",
    "selection",
    "checkpoints",
    "normalized_definitions",
    "migration_descriptors",
    "participants",
    "archive_digest",
    "members",
    "required_determa_capabilities",
    "optional_participant_references",
    "source_fence_reference",
    "transfer_reference"
  ],
  "additionalProperties": false,
  "properties": {
    "archive_format": {
      "const": "determa.scope_archive"
    },
    "archive_schema_version": {
      "const": 1
    },
    "selection": {
      "type": "object",
      "required": [
        "root_instance_ids",
        "consistency_token"
      ],
      "additionalProperties": false,
      "properties": {
        "root_instance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consistency_token": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "execution-checkpoint-v1.schema.json"
      }
    },
    "normalized_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "validated_bundle_fingerprint",
          "normalized_bundle"
        ],
        "additionalProperties": false,
        "properties": {
          "validated_bundle_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "normalized_bundle": {
            "$ref": "aggregate-state-v1.schema.json#/$defs/typedValue"
          }
        }
      }
    },
    "migration_descriptors": {
      "type": "array",
      "items": {
        "$ref": "migration-descriptor-v1.schema.json"
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "archive-participant-v1.schema.json"
      }
    },
    "archive_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "participant_contract": {
      "$ref": "#/$defs/participantContract"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "identity",
          "digest",
          "byte_length"
        ],
        "additionalProperties": false,
        "properties": {
          "identity": {
            "type": "string",
            "pattern": "^(checkpoint|definition|migration_descriptor|participant):.+"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "byte_length": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      }
    },
    "required_determa_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "optional_participant_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/optionalParticipantReference"
      }
    },
    "source_fence_reference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sourceFenceReference"
        }
      ]
    },
    "transfer_reference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/transferReference"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/schema/archive-v1.schema.json",
  "title": "Determa portable archive version 1",
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "profile_kind",
        "profile_claims",
        "profile_digest",
        "logical_scope_identity",
        "ownership_binding_digest",
        "scope_generation"
      ],
      "additionalProperties": false,
      "properties": {
        "profile_kind": {
          "enum": [
            "standalone",
            "checkpoint_host",
            "guarded_scope"
          ]
        },
        "profile_claims": {
          "type": "array",
          "items": {
            "enum": [
              "durable_embedded_processing",
              "exactly_once_committed_processing",
              "broker_integrated",
              "strict_durable_outbox",
              "compact_durable_outbox",
              "shared_application_transaction",
              "guarded_local_writes",
              "worker_fencing",
              "complete_scope_inventory",
              "safe_relocation",
              "durable_native_results",
              "lossless_projection"
            ]
          },
          "uniqueItems": true
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "logical_scope_identity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "ownership_binding_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "scope_generation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile_kind": {
                "const": "standalone"
              }
            },
            "required": [
              "profile_kind"
            ]
          },
          "then": {
            "properties": {
              "profile_claims": {
                "const": []
              },
              "logical_scope_identity": {
                "type": "null"
              },
              "ownership_binding_digest": {
                "type": "null"
              },
              "scope_generation": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile_kind": {
                "const": "guarded_scope"
              }
            },
            "required": [
              "profile_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_scope_identity": {
                "type": "string",
                "minLength": 1
              },
              "ownership_binding_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "scope_generation": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "profile_claims": {
                "type": "array",
                "contains": {
                  "const": "guarded_local_writes"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile_kind": {
                "const": "checkpoint_host"
              }
            },
            "required": [
              "profile_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_scope_identity": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "participantContract": {
      "type": "object",
      "required": [
        "required_participant_ids",
        "optional_participant_ids",
        "participant_contract_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "required_participant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "uniqueItems": true
        },
        "optional_participant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "uniqueItems": true
        },
        "participant_contract_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "capability": {
      "enum": [
        "portable_archive",
        "portable_checkpoint",
        "normalized_definition",
        "migration_descriptor",
        "archive_participant",
        "host_effect_journal"
      ]
    },
    "optionalParticipantReference": {
      "type": "object",
      "required": [
        "participant_id",
        "provider_reference",
        "participant_schema_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "participant_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "provider_reference": {
          "$ref": "provider-reference-v1.schema.json"
        },
        "participant_schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "sourceFenceReference": {
      "type": "object",
      "required": [
        "operation_kind",
        "operation_id",
        "response_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "operation_kind": {
          "enum": [
            "freeze_scope",
            "prove_retirement"
          ]
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "response_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "transferReference": {
      "type": "object",
      "required": [
        "operation_kind",
        "operation_id",
        "response_digest",
        "destination_binding_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "operation_kind": {
          "const": "prove_retirement"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "response_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "destination_binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "profile_kind": {
                "const": "standalone"
              }
            },
            "required": [
              "profile_kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source_fence_reference": {
            "type": "null"
          },
          "transfer_reference": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transfer_reference": {
            "type": "object"
          }
        },
        "required": [
          "transfer_reference"
        ]
      },
      "then": {
        "properties": {
          "source_fence_reference": {
            "$ref": "#/$defs/sourceFenceReference"
          },
          "source": {
            "properties": {
              "profile_claims": {
                "contains": {
                  "const": "safe_relocation"
                }
              }
            }
          }
        }
      }
    }
  ]
}
