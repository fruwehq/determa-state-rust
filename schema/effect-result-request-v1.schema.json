{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/schema/effect-result-request-v1.schema.json",
  "title": "Determa State version 1 effect result request",
  "$ref": "#/$defs/request",
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "effect_id",
        "operation_token",
        "attempt_fence",
        "outcome_kind",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "effect_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "operation_token": {
          "type": "string",
          "minLength": 1
        },
        "attempt_fence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "outcome_kind": {
          "enum": [
            "succeeded",
            "domain_rejected",
            "retryable_failure",
            "terminal_failure",
            "cancelled",
            "ambiguous"
          ]
        },
        "payload": {
          "$ref": "aggregate-state-v1.schema.json#/$defs/typedMap"
        }
      }
    }
  }
}
