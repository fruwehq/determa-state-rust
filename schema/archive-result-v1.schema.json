        },
        "staged": {
          "const": false
        },
        "absent_optional_participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "participant_id",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "participant_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*$"
              },
              "reason": {
                "enum": [
                  "not_present",
                  "provider_unavailable",
                  "schema_unsupported",
                  "capability_unsupported",
                  "payload_unavailable"
                ]
              }
            }
          }
        },
        "unsupported_optional_participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "participant_id",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "participant_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*$"
              },
              "reason": {
                "enum": [
                  "not_present",
                  "provider_unavailable",
                  "schema_unsupported",
                  "capability_unsupported",
                  "payload_unavailable"
