{
  "type": "object",
  "required": [
    "request_format",
    "request_schema_version",
    "source",
    "root_instance_ids",
    "required_participant_ids",
    "optional_participant_ids",
    "consistency_token"
  ],
  "additionalProperties": false,
  "properties": {
    "request_format": {
      "const": "determa.archive_export_request"
    },
    "request_schema_version": {
      "const": 1
    },
    "source": {
      "$ref": "archive-v1.schema.json#/$defs/source"
    },
    "root_instance_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_participant_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*$"
      },
      "uniqueItems": true
    },
    "optional_participant_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*$"
      },
      "uniqueItems": true
    },
    "consistency_token": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/schema/archive-export-request-v1.schema.json",
  "title": "Determa archive export request version 1"
}
