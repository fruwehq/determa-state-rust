{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/schemas/conformance/version2-operation-result.schema.json",
  "title": "Determa State version-2 operation result",
  "oneOf": [
    { "$ref": "#/$defs/admission" },
    { "$ref": "#/$defs/corePendingReplay" },
    { "$ref": "#/$defs/pendingReplay" },
    { "$ref": "#/$defs/terminalReplay" },
    { "$ref": "#/$defs/tombstoneReplay" },
    { "$ref": "#/$defs/batchAdmission" },
    { "$ref": "#/$defs/maintenanceMigration" },
    { "$ref": "#/$defs/migratedAndProcessed" },
    { "$ref": "#/$defs/migration" }
  ],
  "$defs": {
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "admission": {
      "type": "object",
      "required": ["result", "status", "accepted", "state", "rejection"],
      "additionalProperties": false,
      "properties": {
        "result": { "const": "accepted" },
        "status": { "enum": ["running", "completed", "faulted"] },
        "accepted": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["event_id", "acceptance_sequence", "queue_sequence"],
            "additionalProperties": false,
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "acceptance_sequence": { "$ref": "#/$defs/canonicalDecimal" },
              "queue_sequence": { "$ref": "#/$defs/canonicalDecimal" }
            }
          }
        },
        "state": { "$ref": "https://determa.dev/state/schema/aggregate-state-v2.schema.json" },
        "rejection": { "type": "null" }
      }
    },
    "pendingReplay": {
      "type": "object",
      "required": ["result", "event_id", "acceptance_sequence", "location"],
      "additionalProperties": false,
      "properties": {
        "result": { "const": "replay" },
        "event_id": { "type": "string", "minLength": 1 },
        "acceptance_sequence": { "$ref": "#/$defs/canonicalDecimal" },
        "location": { "enum": ["ready", "deferred"] }
      }
    },
    "corePendingReplay": {
      "type": "object",
      "required": ["result", "status", "event_id", "acceptance_sequence", "location", "state", "rejection"],
      "additionalProperties": false,
      "properties": {
        "result": { "const": "replay" },
        "status": { "enum": ["running", "completed", "faulted"] },
        "event_id": { "type": "string", "minLength": 1 },
        "acceptance_sequence": { "$ref": "#/$defs/canonicalDecimal" },
        "location": { "enum": ["ready", "deferred"] },
        "state": { "$ref": "https://determa.dev/state/schema/aggregate-state-v2.schema.json" },
        "rejection": { "type": "null" }
      }
    },
    "terminalReplay": {
      "type": "object",
      "required": ["result", "acceptance_receipt_sequence", "terminal_receipt_sequence"],
      "additionalProperties": false,
      "properties": {
        "result": { "const": "replay" },
        "acceptance_receipt_sequence": { "$ref": "#/$defs/canonicalDecimal" },
        "terminal_receipt_sequence": { "$ref": "#/$defs/canonicalDecimal" }
      }
    },
    "tombstoneReplay": {
      "type": "object",
      "required": ["result", "terminal_receipt_sequence", "terminal_disposition"],
      "additionalProperties": false,
      "properties": {
        "result": { "const": "replay" },
        "terminal_receipt_sequence": { "$ref": "#/$defs/canonicalDecimal" },
        "terminal_disposition": {
          "enum": ["handled", "unhandled", "faulted", "disposed", "migration_disposed"]
        }
      }
    },
    "batchMember": {
      "oneOf": [
        {
          "type": "object",
          "required": ["event_id", "disposition", "acceptance_sequence", "queue_sequence"],
          "additionalProperties": false,
          "properties": {
            "event_id": { "type": "string", "minLength": 1 },
            "disposition": { "const": "accepted" },
            "acceptance_sequence": { "$ref": "#/$defs/canonicalDecimal" },
            "queue_sequence": { "$ref": "#/$defs/canonicalDecimal" }
          }
        },
        {
          "type": "object",
          "required": ["event_id", "disposition", "evidence"],
          "additionalProperties": false,
          "properties": {
            "event_id": { "type": "string", "minLength": 1 },
            "disposition": { "const": "replay" },
            "evidence": {
              "oneOf": [
                { "$ref": "#/$defs/pendingReplay" },
                { "$ref": "#/$defs/terminalReplay" },
                { "$ref": "#/$defs/tombstoneReplay" }
              ]
            }
          }
        }
      ]
    },
    "batchAdmission": {
      "type": "object",
      "required": ["result", "members", "checkpoint"],
      "additionalProperties": false,
      "properties": {
        "result": { "const": "batch" },
        "members": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/batchMember" }
        },
        "checkpoint": { "$ref": "https://determa.dev/state/schema/execution-checkpoint-v2.schema.json" }
      }
    },
    "maintenanceMigration": {
      "type": "object",
      "required": ["result", "receipt"],
      "additionalProperties": false,
      "properties": {
        "result": { "const": "committed" },
        "receipt": {
          "$ref": "https://determa.dev/state/schema/execution-checkpoint-v2.schema.json#/$defs/maintenanceMigrationReceipt"
        }
      }
    },
    "migrationDisposition": {
      "type": "object",
      "required": ["disposition", "reason", "migration_descriptor_digest"],
      "additionalProperties": false,
      "properties": {
        "disposition": { "const": "migration_disposed" },
        "reason": { "type": "string", "minLength": 1 },
        "migration_descriptor_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "migrationAuditRecord": {
      "type": "object",
      "required": [
        "migration_audit_record_schema_version",
        "root_instance_id",
        "root_runtime_id",
        "migration_sequence",
        "source_validated_bundle_fingerprint",
        "target_validated_bundle_fingerprint",
        "migration_descriptor_digest",
        "source_aggregate_state_digest",
        "target_aggregate_state_digest",
        "result_code"
      ],
      "additionalProperties": false,
      "properties": {
        "migration_audit_record_schema_version": { "const": 2 },
        "root_instance_id": { "type": "string", "minLength": 1 },
        "root_runtime_id": { "type": "string", "minLength": 1 },
        "migration_sequence": { "$ref": "#/$defs/canonicalDecimal" },
        "source_validated_bundle_fingerprint": { "$ref": "#/$defs/sha256" },
        "target_validated_bundle_fingerprint": { "$ref": "#/$defs/sha256" },
        "migration_descriptor_digest": { "$ref": "#/$defs/sha256" },
        "source_aggregate_state_digest": { "$ref": "#/$defs/sha256" },
        "target_aggregate_state_digest": { "$ref": "#/$defs/sha256" },
        "result_code": { "const": "migration_applied" }
      }
    },
    "migration": {
      "type": "object",
      "required": ["result", "aggregate_state", "dispositions", "audit_records"],
      "additionalProperties": false,
      "properties": {
        "result": { "const": "success" },
        "aggregate_state": { "$ref": "https://determa.dev/state/schema/aggregate-state-v2.schema.json" },
        "dispositions": {
          "type": "array",
          "items": { "$ref": "#/$defs/migrationDisposition" }
        },
        "audit_records": {
          "type": "array",
          "items": { "$ref": "#/$defs/migrationAuditRecord" }
        }
      }
    },
    "migrationAdmissionRejection": {
      "type": "object",
      "required": [
        "core_step_result_format", "core_step_result_schema_version", "status",
        "disposition", "state", "emissions", "lifecycle_dispositions", "fault",
        "rejection"
      ],
      "additionalProperties": false,
      "properties": {
        "core_step_result_format": { "const": "determa.core_step_result" },
        "core_step_result_schema_version": { "const": 2 },
        "status": { "enum": ["running", "completed", "faulted"] },
        "disposition": { "const": "rejected" },
        "state": { "$ref": "https://determa.dev/state/schema/aggregate-state-v2.schema.json" },
        "emissions": { "type": "array", "maxItems": 0 },
        "lifecycle_dispositions": { "type": "array", "maxItems": 0 },
        "fault": { "type": "null" },
        "rejection": {
          "type": "object",
          "required": ["code"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "invalid_delivery_mode", "invalid_delivery_source",
                "invalid_instance_target", "inactive_component_target",
                "invalid_event", "invalid_payload", "invalid_correlation",
                "delivery_digest_mismatch"
              ]
            }
          }
        }
      }
    },
    "migratedAndProcessed": {
      "type": "object",
      "required": ["result", "migration_audit_records", "processing"],
      "additionalProperties": false,
      "properties": {
        "result": { "const": "migrated_and_processed" },
        "migration_audit_records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/migrationAuditRecord" }
        },
        "processing": {
          "oneOf": [
            { "$ref": "https://determa.dev/state/schema/core-step-result-v2.schema.json" },
            { "$ref": "#/$defs/migrationAdmissionRejection" }
          ]
        }
      }
    }
  }
}
