      "durable_host_conformance::every_returned_persistence_response_rejects_an_extra_member"
    ]
  },
  "runs": [
    {
      "command": [
        "python3",
        "scripts/native_gate_report.py",
        "--require-postgresql",
        "--lib",
        "--report",
        "{report}",
        "--test",
        "adapter_selection",
        "--test",
        "extension_conformance",
        "--test",
        "checkpoint_adapters",
        "--test",
        "checkpoint_postgresql",
        "--test",
        "durable_host_conformance",
        "--test",
        "native_worker_composition"
      ],
      "report": "native-gates.xml",
      "required_environment": [
        "DETERMA_TEST_POSTGRES_URL"
      ]
    }
  ]
}
